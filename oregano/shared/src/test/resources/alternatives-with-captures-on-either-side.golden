          if (`lp₄`.>=(0)) `lp₄` else if (`startPos₂`.<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`).==(99))) if (`startPos₂`.+(1).<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`.+(1)).==(100))) `startPos₂`.+(1).+(1) else -1 else -1
        }).apply(pos, `source₂`)
