        if (lp.>=(0)) lp else if (0.<(`input₂`.length()).&&(`input₂`.charAt(0).==(99))) if (0.+(1).<(`input₂`.length()).&&(`input₂`.charAt(0.+(1)).==(100))) if (0.+(1).+(1).==(`input₂`.length())) 0.+(1).+(1) else -1 else -1 else -1
