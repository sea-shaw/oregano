          val `lp₄`: Int = if (`startPos₂`.<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`).==(97))) if (`startPos₂`.+(1).<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`.+(1)).==(98))) `startPos₂`.+(1).+(1) else -1 else -1
          if (`lp₄`.>=(0)) `lp₄` else `startPos₂`
        }).apply(pos, `source₂`)
        if (`matchPos₂`.!=(-1)) return Some.apply[String](`source₂`.subSequence(pos, `matchPos₂`).toString()) else ()
        pos = pos.+(1)
      }
      None
    }
    override def split(toSplit: CharSequence): Array[String] = {
      val `result₃`: ArrayBuffer[String] = scala.collection.mutable.ArrayBuffer.empty[String]
      val `len₂`: Int = toSplit.length()
      var `pos₂`: Int = 0
      var lastEnd: Int = 0
      while (`pos₂`.<(`len₂`)) {
        val matchEnd: Int = ((`startPos₃`: Int, `input₇`: CharSequence) => {
          val `lp₅`: Int = if (`startPos₃`.<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`).==(97))) if (`startPos₃`.+(1).<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`.+(1)).==(98))) `startPos₃`.+(1).+(1) else -1 else -1
          if (`lp₅`.>=(0)) `lp₅` else `startPos₃`
