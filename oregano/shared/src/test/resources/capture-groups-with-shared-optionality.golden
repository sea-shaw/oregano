        } else `pos₂` = `pos₂`.+(1)
      }
      if (lastEnd.!=(`len₂`)) {
        `result₃`.+=(toSplit.subSequence(lastEnd, `len₂`).toString())
        ()
      } else ()
      `result₃`.toArray[String](ClassTag.apply[String](classOf[String]))
    }
    override def unapply(`input₈`: CharSequence): Option[Option[Tuple2[String, String]]] = $anon.this.matchesWithCaps(`input₈`).map[Option[Tuple2[String, String]]](((caps: Array[Int]) => {
      val hchain: HSingleton[Option[HAppend[HSingleton[String], HSingleton[String]]]] = {
        val opt: Option[Sanitised[HAppend[HSingleton[String], HSingleton[String]]]] = {
          val left: Option[Sanitised[HSingleton[String]]] = {
            val cap: Option[String] = {
              val l: Int = caps.apply(2)
              val u: Int = caps.apply(3)
              if (l.>=(0).&&(u.>=(0))) Some.apply[String](`input₈`.subSequence(l, u).toString()) else None
            }
            if (cap.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](cap.get), true)) else None
          }
          val right: Option[Sanitised[HSingleton[String]]] = {
            val `cap₂`: Option[String] = {
              val `l₂`: Int = caps.apply(4)
              val `u₂`: Int = caps.apply(5)
              if (`l₂`.>=(0).&&(`u₂`.>=(0))) Some.apply[String](`input₈`.subSequence(`l₂`, `u₂`).toString()) else None
