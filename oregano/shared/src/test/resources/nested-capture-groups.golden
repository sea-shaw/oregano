              val `res₂₇`: Int = if (`startPos₃`.+(1).+(1).<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`.+(1).+(1)).toInt.==(99))) {
                val `res₂₈`: Int = if (`startPos₃`.+(1).+(1).+(1).<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`.+(1).+(1).+(1)).toInt.==(100))) {
                  val `res₂₉`: Int = if (`startPos₃`.+(1).+(1).+(1).+(1).<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`.+(1).+(1).+(1).+(1)).toInt.==(101))) {
                    val `res₃₀`: Int = `startPos₃`.+(1).+(1).+(1).+(1).+(1)

