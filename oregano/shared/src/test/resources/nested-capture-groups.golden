{
  final class $anon() extends Regex[Tuple3[String, String, String]] {
    override def matches(input: CharSequence): Boolean = ((`input₂`: CharSequence) => {
      val result: Int = if (0.<(`input₂`.length()).&&(`input₂`.charAt(0).==(97))) if (0.+(1).<(`input₂`.length()).&&(`input₂`.charAt(0.+(1)).==(98))) if (0.+(1).+(1).<(`input₂`.length()).&&(`input₂`.charAt(0.+(1).+(1)).==(99))) if (0.+(1).+(1).+(1).<(`input₂`.length()).&&(`input₂`.charAt(0.+(1).+(1).+(1)).==(100))) if (0.+(1).+(1).+(1).+(1).<(`input₂`.length()).&&(`input₂`.charAt(0.+(1).+(1).+(1).+(1)).==(101))) if (0.+(1).+(1).+(1).+(1).+(1).==(`input₂`.length())) 0.+(1).+(1).+(1).+(1).+(1) else -1 else -1 else -1 else -1 else -1 else -1
      result.==(`input₂`.length())
    }).apply(input)
    override def matchesWithCaps(`input₃`: CharSequence): Option[Array[Int]] = ((`input₄`: CharSequence) => {
      val inputLen: Int = `input₄`.length()
      val groups: Array[Int] = Array.fill[Int](8)(-1)(ClassTag.apply[Int](classOf[Int]))
      groups.update(0, 0)
      val `result₂`: Int = {
        val savedStart: Int = groups.apply(2)
        groups.update(2, 0)
        val res: Int = if (0.<(`input₄`.length()).&&(`input₄`.charAt(0).==(97))) {
          val `savedStart₂`: Int = groups.apply(4)
          groups.update(4, 0.+(1))
          val `res₂`: Int = if (0.+(1).<(`input₄`.length()).&&(`input₄`.charAt(0.+(1)).==(98))) {
            val `savedStart₃`: Int = groups.apply(6)
            groups.update(6, 0.+(1).+(1))
            val `res₃`: Int = if (0.+(1).+(1).<(`input₄`.length()).&&(`input₄`.charAt(0.+(1).+(1)).==(99))) {
              val savedEnd: Int = groups.apply(7)
              groups.update(7, 0.+(1).+(1).+(1))
              val `res₄`: Int = if (0.+(1).+(1).+(1).<(`input₄`.length()).&&(`input₄`.charAt(0.+(1).+(1).+(1)).==(100))) {
                val `savedEnd₂`: Int = groups.apply(5)
                groups.update(5, 0.+(1).+(1).+(1).+(1))
                val `res₅`: Int = if (0.+(1).+(1).+(1).+(1).<(`input₄`.length()).&&(`input₄`.charAt(0.+(1).+(1).+(1).+(1)).==(101))) {
                  val `savedEnd₃`: Int = groups.apply(3)
                  groups.update(3, 0.+(1).+(1).+(1).+(1).+(1))
                  val `res₆`: Int = if (0.+(1).+(1).+(1).+(1).+(1).==(inputLen)) 0.+(1).+(1).+(1).+(1).+(1) else -1

                  (if (`res₆`.>=(0)) `res₆` else {
                    groups.update(3, `savedEnd₃`)
                    -1
                  }: Int)
                } else -1

                (if (`res₅`.>=(0)) `res₅` else {
                  groups.update(5, `savedEnd₂`)
                  -1
                }: Int)
              } else -1

              (if (`res₄`.>=(0)) `res₄` else {
                groups.update(7, savedEnd)
                -1
              }: Int)
            } else -1

            (if (`res₃`.>=(0)) `res₃` else {
              groups.update(6, `savedStart₃`)
              -1
            }: Int)
          } else -1

          (if (`res₂`.>=(0)) `res₂` else {
            groups.update(4, `savedStart₂`)
            -1
          }: Int)
        } else -1

        (if (res.>=(0)) res else {
          groups.update(2, savedStart)
          -1
        }: Int)
      }
      if (`result₂`.==(inputLen)) {
        groups.update(1, `result₂`)
        Some.apply[Array[Int]](groups)
      } else None
    }).apply(`input₃`)
    override def findPrefixOf(source: CharSequence): Option[String] = {
      val matchPos: Int = ((startPos: Int, `input₅`: CharSequence) => if (startPos.<(`input₅`.length()).&&(`input₅`.charAt(startPos).==(97))) if (startPos.+(1).<(`input₅`.length()).&&(`input₅`.charAt(startPos.+(1)).==(98))) if (startPos.+(1).+(1).<(`input₅`.length()).&&(`input₅`.charAt(startPos.+(1).+(1)).==(99))) if (startPos.+(1).+(1).+(1).<(`input₅`.length()).&&(`input₅`.charAt(startPos.+(1).+(1).+(1)).==(100))) if (startPos.+(1).+(1).+(1).+(1).<(`input₅`.length()).&&(`input₅`.charAt(startPos.+(1).+(1).+(1).+(1)).==(101))) startPos.+(1).+(1).+(1).+(1).+(1) else -1 else -1 else -1 else -1 else -1).apply(0, source)
      Option.when[String](matchPos.!=(-1))(source.subSequence(0, matchPos).toString())
    }
    override def findFirstIn(`source₂`: CharSequence): Option[String] = {
      val len: Int = `source₂`.length()
      var pos: Int = 0
      while (pos.<(len)) {
        val `matchPos₂`: Int = ((`startPos₂`: Int, `input₆`: CharSequence) => if (`startPos₂`.<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`).==(97))) if (`startPos₂`.+(1).<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`.+(1)).==(98))) if (`startPos₂`.+(1).+(1).<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`.+(1).+(1)).==(99))) if (`startPos₂`.+(1).+(1).+(1).<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`.+(1).+(1).+(1)).==(100))) if (`startPos₂`.+(1).+(1).+(1).+(1).<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`.+(1).+(1).+(1).+(1)).==(101))) `startPos₂`.+(1).+(1).+(1).+(1).+(1) else -1 else -1 else -1 else -1 else -1).apply(pos, `source₂`)
        if (`matchPos₂`.!=(-1)) return Some.apply[String](`source₂`.subSequence(pos, `matchPos₂`).toString()) else ()
        pos = pos.+(1)
      }
      None
    }
    override def split(toSplit: CharSequence): Array[String] = {
      val `result₃`: ArrayBuffer[String] = scala.collection.mutable.ArrayBuffer.empty[String]
      val `len₂`: Int = toSplit.length()
      var `pos₂`: Int = 0
      var lastEnd: Int = 0
      while (`pos₂`.<(`len₂`)) {
        val matchEnd: Int = ((`startPos₃`: Int, `input₇`: CharSequence) => if (`startPos₃`.<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`).==(97))) if (`startPos₃`.+(1).<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`.+(1)).==(98))) if (`startPos₃`.+(1).+(1).<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`.+(1).+(1)).==(99))) if (`startPos₃`.+(1).+(1).+(1).<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`.+(1).+(1).+(1)).==(100))) if (`startPos₃`.+(1).+(1).+(1).+(1).<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`.+(1).+(1).+(1).+(1)).==(101))) `startPos₃`.+(1).+(1).+(1).+(1).+(1) else -1 else -1 else -1 else -1 else -1).apply(`pos₂`, toSplit)
        if (matchEnd.!=(-1)) {
          `result₃`.+=(toSplit.subSequence(lastEnd, `pos₂`).toString())
          lastEnd = matchEnd
          `pos₂` = if (matchEnd.==(`pos₂`)) `pos₂`.+(1) else matchEnd
        } else `pos₂` = `pos₂`.+(1)
      }
      if (lastEnd.!=(`len₂`)) {
        `result₃`.+=(toSplit.subSequence(lastEnd, `len₂`).toString())
        ()
      } else ()
      `result₃`.toArray[String](ClassTag.apply[String](classOf[String]))
    }
    override def unapply(`input₈`: CharSequence): Option[Tuple3[String, String, String]] = $anon.this.matchesWithCaps(`input₈`).map[Tuple3[String, String, String]](((caps: Array[Int]) => {
      val hchain: HAppend[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]] = HAppend.apply[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]](HSingleton.apply[String](`input₈`.subSequence(caps.apply(2), caps.apply(3)).toString()), HAppend.apply[HSingleton[String], HSingleton[String]](HSingleton.apply[String](`input₈`.subSequence(caps.apply(4), caps.apply(5)).toString()), HSingleton.apply[String](`input₈`.subSequence(caps.apply(6), caps.apply(7)).toString())))
      val node: HAppend[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]] = hchain
      val `node₂`: HAppend[HSingleton[String], HSingleton[String]] = node.right
      Tuple3.apply[String, String, String](node.left.value, `node₂`.left.value, `node₂`.right.value)
    }))
  }

  (new $anon(): Regex[Tuple3[String, String, String]])
}