        val matchEnd: Int = ((`startPos₃`: Int, `input₇`: CharSequence) => if (`startPos₃`.<(`input₇`.length()).&&(`input₇`.charAt(`startPos₃`).==(97))) `startPos₃`.+(1) else -1).apply(`pos₂`, toSplit)
        if (matchEnd.!=(-1)) {
          `result₃`.+=(toSplit.subSequence(lastEnd, `pos₂`).toString())
          lastEnd = matchEnd
          `pos₂` = if (matchEnd.==(`pos₂`)) `pos₂`.+(1) else matchEnd
        } else `pos₂` = `pos₂`.+(1)
      }
      if (lastEnd.!=(`len₂`)) {
        `result₃`.+=(toSplit.subSequence(lastEnd, `len₂`).toString())
        ()
      } else ()
      `result₃`.toArray[String](ClassTag.apply[String](classOf[String]))
    }
    override def unapply(`input₈`: CharSequence): Option[String] = $anon.this.matchesWithCaps(`input₈`).map[String](((caps: Array[Int]) => {
