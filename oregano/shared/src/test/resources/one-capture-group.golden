      result.==(`input₂`.length())
    }).apply(input)
    override def matchesWithCaps(`input₃`: CharSequence): Option[Array[Int]] = ((`input₄`: CharSequence) => {
      val inputLen: Int = `input₄`.length()
      val groups: Array[Int] = Array.fill[Int](4)(-1)(ClassTag.apply[Int](classOf[Int]))
      groups.update(0, 0)
      val `result₂`: Int = {
        val savedStart: Int = groups.apply(2)
        groups.update(2, 0)
        val res: Int = if (0.<(`input₄`.length()).&&(`input₄`.charAt(0).==(97))) {
          val savedEnd: Int = groups.apply(3)
          groups.update(3, 0.+(1))
          val `res₂`: Int = if (0.+(1).==(inputLen)) 0.+(1) else -1

          (if (`res₂`.>=(0)) `res₂` else {
            groups.update(3, savedEnd)
            -1
          }: Int)
        } else -1

        (if (res.>=(0)) res else {
          groups.update(2, savedStart)
          -1
        }: Int)
      }
      if (`result₂`.==(inputLen)) {
        groups.update(1, `result₂`)
        Some.apply[Array[Int]](groups)
      } else None
    }).apply(`input₃`)
    override def findPrefixOf(source: CharSequence): Option[String] = {
      val matchPos: Int = ((startPos: Int, `input₅`: CharSequence) => if (startPos.<(`input₅`.length()).&&(`input₅`.charAt(startPos).==(97))) startPos.+(1) else -1).apply(0, source)
      Option.when[String](matchPos.!=(-1))(source.subSequence(0, matchPos).toString())
    }
    override def findFirstIn(`source₂`: CharSequence): Option[String] = {
      val len: Int = `source₂`.length()
      var pos: Int = 0
      while (pos.<(len)) {
        val `matchPos₂`: Int = ((`startPos₂`: Int, `input₆`: CharSequence) => if (`startPos₂`.<(`input₆`.length()).&&(`input₆`.charAt(`startPos₂`).==(97))) `startPos₂`.+(1) else -1).apply(pos, `source₂`)
        if (`matchPos₂`.!=(-1)) return Some.apply[String](`source₂`.subSequence(pos, `matchPos₂`).toString()) else ()
        pos = pos.+(1)
      }
      None
    }
    override def split(toSplit: CharSequence): Array[String] = {
      val `result₃`: ArrayBuffer[String] = scala.collection.mutable.ArrayBuffer.empty[String]
